# Client
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: full public WebSocket base URL for remote/tunnel testing, e.g. wss://your-ws-tunnel.example.com
VITE_WS_URL=
VITE_WS_PORT=3001

# Server
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional comma-separated origins used to validate Clerk session tokens over WebSocket.
# Example: http://localhost:3000,http://192.168.137.1:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key
WS_PORT=3001

# Existing DevCollective services
GEMINI_API_KEY=your_gemini_key
APP_URL=http://localhost:3000

# Mentor application email is server-side only. Configure it in Supabase Edge Function secrets.
MENTOR_APPLICATION_EMAIL=mentor-applications@your-domain.com

# Transactional email (Supabase Edge Functions)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=DevCollective <notifications@your-verified-domain.com>
# Supabase Edge Function CORS allowlist, comma-separated.
MENTOR_ALLOWED_ORIGINS=http://localhost:3000,https://devcollective-app.onrender.com
