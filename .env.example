# Primary AI provider
# GEMINI_API_KEY: Used for resume parsing, chatbot, and Roadmap Mentor.
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Fallback AI provider
# GROQ_API_KEY: Used automatically when Gemini is rate-limited/unavailable.
# Get one from https://console.groq.com/keys
GROQ_API_KEY=""

# Groq model used by the fallback. GPT-OSS 20B supports JSON mode and tool use.
GROQ_MODEL="openai/gpt-oss-20b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

EMAIL_USER=""
EMAIL_APP_PASSWORD=""
