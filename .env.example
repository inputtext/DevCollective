# GEMINI_API_KEY: Required for Gemini API calls (resume parser, chatbot, roadmap mentor).
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# Supabase: server-side only. NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# DevCollective project ref: jzanieialphvqtnzoncp
SUPABASE_URL="https://jzanieialphvqtnzoncp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
